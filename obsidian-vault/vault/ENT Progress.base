filters:
  and:
    - 'note.type == "concept"'
formulas:
  flag: 'if(note.status == "mastered", "✅", if(note.status == "solid", "🟩", if(note.status == "learning", "🔶", "⬜")))'
properties:
  formula.flag:
    displayName: " "
  note.section:
    displayName: Section
  note.topic_no:
    displayName: "#"
  note.status:
    displayName: Status
  note.high_yield:
    displayName: High-yield
  file.mtime:
    displayName: Edited
views:
  - type: table
    name: By Section
    groupBy:
      property: note.section
      direction: ASC
    order:
      - formula.flag
      - note.topic_no
      - file.name
      - note.status
      - file.mtime
  - type: table
    name: Needs work
    filters:
      and:
        - 'note.status != "mastered"'
    order:
      - formula.flag
      - note.section
      - note.topic_no
      - note.status
  - type: table
    name: High-yield
    filters:
      and:
        - 'note.high_yield == true'
    order:
      - formula.flag
      - note.section
      - file.name
      - note.status
  - type: cards
    name: Has sources
    filters:
      and:
        - 'note.sources'
    order:
      - note.section
      - note.status
